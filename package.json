{
  "name": "@zoontek/chicane",
  "version": "3.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "type": "module",
  "description": "A simple and safe router for React and TypeScript",
  "author": "Mathieu Acthernoene <zoontek@gmail.com>",
  "homepage": "https://zoontek.github.io/chicane",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoontek/chicane.git"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.js",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "hook",
    "react",
    "router",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "format": "prettier '**/*' --ignore-unknown --write",
    "lint": "oxlint --type-aware",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "dependencies": {
    "@emotion/hash": "^0.9.2",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/use-sync-external-store": "^1.5.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
